diff --git a/test/test_buffer_contract.cpp b/test/test_buffer_contract.cpp
new file mode 100644
index 0000000..968a56c
--- /dev/null
+++ b/test/test_buffer_contract.cpp
@@ -0,0 +1,50 @@
+#undef NDEBUG  // Assertions remain active in Release builds of this regression test.
+#include <cassert>
+#include <deque>
+#include <memory>
+#include <vector>
+#include "buffer_contract.h"
+
+struct Cloud
+{
+  std::vector<int> points;
+  Cloud & operator+=(const Cloud & other)
+  {
+    points.insert(points.end(), other.points.begin(), other.points.end());
+    return *this;
+  }
+  void swap(Cloud & other) {points.swap(other.points);}
+};
+
+int main()
+{
+  // Simulate an out-of-view camera producing no RGB points for 100000 windows.
+  Cloud pending, batch;
+  batch.points.resize(100);
+  std::size_t count = 0, projected = 0;
+  for (int i = 0; i < 100000; ++i) {
+    fast_livo::consume_publication_window(pending, batch, count, 2,
+      [&projected](const Cloud & cloud) {
+        assert(cloud.points.size() == 200);
+        ++projected;
+        // Intentionally no RGB output.
+      });
+    assert(pending.points.size() <= 100);
+  }
+  assert(projected == 50000 && count == 0 && pending.points.empty());
+  std::deque<std::shared_ptr<int>> measurements;
+  std::weak_ptr<int> old;
+  for (int i = 0; i < 100000; ++i) {
+    auto current = std::make_shared<int>(i);
+    fast_livo::replace_measurement(measurements, current);
+    assert(old.expired());
+    assert(measurements.size() == 1);
+    old = current;
+  }
+  fast_livo::require_buffer_space(7, 8, "image");
+  bool rejected = false;
+  try {fast_livo::require_buffer_space(8, 8, "image");}
+  catch (const std::runtime_error &) {rejected = true;}
+  assert(rejected);
+  return 0;
+}
diff --git a/test/test_measurement_stamp.cpp b/test/test_measurement_stamp.cpp
new file mode 100644
index 0000000..40ec2ac
--- /dev/null
+++ b/test/test_measurement_stamp.cpp
@@ -0,0 +1,30 @@
+#undef NDEBUG
+#include <cassert>
+#include <limits>
+#include "measurement_stamp.h"
+
+int main()
+{
+  using fast_livo::inspect_measurement_stamp;
+  using fast_livo::StampStatus;
+  assert(inspect_measurement_stamp(100.0, -1.0) == StampStatus::accepted);
+  assert(inspect_measurement_stamp(100.01, 100.0) == StampStatus::accepted);
+  assert(inspect_measurement_stamp(100.0, 100.0) == StampStatus::out_of_order);
+  assert(inspect_measurement_stamp(99.9, 100.0) == StampStatus::out_of_order);
+  assert(inspect_measurement_stamp(99.5, 100.0) == StampStatus::out_of_order);
+  assert(inspect_measurement_stamp(99.49, 100.0) == StampStatus::clock_reset);
+  for (double value : {0.0, -1.0, std::numeric_limits<double>::infinity(),
+      std::numeric_limits<double>::quiet_NaN()}) {
+    assert(inspect_measurement_stamp(value, 100.0) == StampStatus::invalid);
+  }
+  fast_livo::require_new_odometry_stamp(100.0, -1.0);
+  fast_livo::require_new_odometry_stamp(100.01, 100.0);
+  for (double value : {0.0, -1.0, 99.0, 100.0,
+      std::numeric_limits<double>::infinity(), std::numeric_limits<double>::quiet_NaN()}) {
+    bool rejected = false;
+    try {fast_livo::require_new_odometry_stamp(value, 100.0);}
+    catch (const std::runtime_error &) {rejected = true;}
+    assert(rejected);
+  }
+  return 0;
+}
