+++ b/test/test_vio_patch_lifetime.cpp
@@ -0,0 +1,56 @@
+#include <atomic>
+#include <cstdlib>
+#include <new>
+#include <cstdio>
+#include "vio.h"
+
+// Interpose patch-sized array allocation in libvio. Ignore unrelated lazy or
+// background allocations from the linked camera/PCL/ROS libraries.
+static std::atomic<std::size_t> arrays{0};
+void * operator new[](std::size_t size)
+{
+  if (size == 64 * sizeof(float)) {++arrays;}
+  if (void * result = std::malloc(size ? size : 1)) {return result;}
+  throw std::bad_alloc();
+}
+void operator delete[](void * pointer) noexcept {std::free(pointer);}
+void operator delete[](void * pointer, std::size_t) noexcept {std::free(pointer);}
+
+int main()
+{
+  vk::PinholeCamera camera(100, 100, 1.0, 50, 50, 50, 50);
+  cv::Mat image(100, 100, CV_8UC1, cv::Scalar(128));
+  StatesGroup state;
+  VIOManager vio;
+  vio.visual_submap = new SubSparseMap;
+  vio.cam = &camera;
+  vio.new_frame_.reset(new Frame(&camera, image));
+  vio.new_frame_->T_f_w_ = SE3();
+  vio.state = &state;
+  vio.width = vio.height = 100;
+  vio.patch_size = 8;
+  vio.patch_size_half = 4;
+  vio.patch_size_total = 64;
+  vio.total_points = 1;
+  vio.update_flag.resize(1, 0);
+  vio.visual_submap->search_levels.push_back(0);
+  auto point = std::make_unique<VisualPoint>(V3D(0, 0, 2));
+  auto feature = new Feature(point.get(), new float[64], V2D(50, 50), V3D(0, 0, 1), SE3(), 0);
+  point->addFrameRef(feature);
+  vio.visual_submap->voxel_points.push_back(point.get());
+  // Allow one-time camera/math/runtime lazy initialization before counting.
+  // A per-call patch leak still produces 1000 new arrays after this warmup.
+  for (int i = 0; i < 10; ++i) {vio.updateVisualMapPoints(image);}
+  const auto before = arrays.load();
+  for (int i = 0; i < 1000; ++i) {vio.updateVisualMapPoints(image);}
+  std::fprintf(stderr, "no-add: array allocations=%zu, observations=%zu\n",
+    arrays.load() - before, point->obs_.size());
+  if (arrays.load() != before || point->obs_.size() != 1) {return 1;}
+  // The add path must still allocate one patch and attach one owned Feature.
+  feature->px_ = V2D(0, 0);
+  vio.updateVisualMapPoints(image);
+  std::fprintf(stderr, "add: array allocations=%zu, observations=%zu\n",
+    arrays.load() - before, point->obs_.size());
+  if (point->obs_.size() != 2 || arrays.load() != before + 1) {return 2;}
+  return 0;
+}
