+        self.assertIn('odomAftMapped.header.stamp = sec_to_stamp(measured)', publish)
+        self.assertIn('tf_msg.header.stamp = odomAftMapped.header.stamp', publish)
+        self.assertNotIn('now_stamp()', publish)
+        self.assertNotIn('_state.pos_end', publish)
+        for axis in 'xyz':
+            self.assertIn(f'tf_msg.transform.translation.{axis} = '
+                          f'odomAftMapped.pose.pose.position.{axis};', publish)
+        self.assertIn('tf_msg.transform.rotation = odomAftMapped.pose.pose.orientation;', publish)
+        pose = source.split('void LIVMapper::set_posestamp', 1)[1].split(
+            'void LIVMapper::publish_odometry()', 1)[0]
+        self.assertIn(
+            'fast_livo::base_pose_from_imu(_state.rot_end, _state.pos_end, imu_base_)', pose)
+
+    def test_actual_buffer_helper_wiring(self):
+        """The tested retention helpers must be used by the mapper callbacks."""
+        source = (ROOT / 'src/LIVMapper.cpp').read_text()
+        self.assertNotIn('keep_last(200000)', source)
+        self.assertNotIn('meas.measures.push_back', source)
+        self.assertEqual(source.count('fast_livo::replace_measurement(meas.measures, m)'), 3)
+        self.assertIn('fast_livo::consume_publication_window(*pcl_wait_pub', source)
+        self.assertIn('if (img_en) {\n    sub_img =', source)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
