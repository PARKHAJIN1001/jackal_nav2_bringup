new file mode 100644
index 0000000..cbc7a14
--- /dev/null
+++ b/test/test_nav2_output_contract.py
@@ -0,0 +1,138 @@
+"""Headless launch evaluation and source wiring checks, not a live ROS/TF test."""
+
+import ast
+import importlib.util
+import math
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+
+ROOT = Path(__file__).resolve().parents[1]
+LAUNCH = ROOT / 'launch/mapping_mid360.launch.py'
+spec = importlib.util.spec_from_file_location('mid360_mapping_contract', LAUNCH)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+def rotation(q):
+    """Convert an xyzw quaternion to a rotation matrix for independent checks."""
+    x, y, z, w = q
+    return [
+        [1 - 2*(y*y + z*z), 2*(x*y - z*w), 2*(x*z + y*w)],
+        [2*(x*y + z*w), 1 - 2*(x*x + z*z), 2*(y*z - x*w)],
+        [2*(x*z - y*w), 2*(y*z + x*w), 1 - 2*(x*x + y*y)],
+    ]
+
+
+class OutputContract(unittest.TestCase):
+    """Check launch values and connection to the actual publish implementation."""
+
+    def setUp(self):
+        """Collect literal launch defaults without starting a LaunchService."""
+        self.args = {}
+        for node in ast.walk(ast.parse(LAUNCH.read_text())):
+            if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Name):
+                continue
+            if node.func.id == 'DeclareLaunchArgument':
+                key = ast.literal_eval(node.args[0])
+                self.assertNotIn(key, self.args)
+                for kw in node.keywords:
+                    if kw.arg == 'default_value' and isinstance(kw.value, ast.Constant):
+                        self.args[key] = ast.literal_eval(kw.value)
+        self.args.update({
+            'extrinsic_path': str(ROOT / 'test/data/extrinsic.txt'),
+            'intrinsic_path': str(ROOT / 'test/data/intrinsic.txt'),
+        })
+
+    def nodes(self, **overrides):
+        """Evaluate node descriptions using captured parameters only."""
+        args = {**self.args, **overrides}
+
+        class Configuration:
+
+            def __init__(self, name):
+                self.name = name
+
+            def perform(self, _context):
+                return args[self.name]
+
+        # Evaluate the real launch callback, but NEVER execute a Node/LaunchService.
+        with patch.object(module, 'LaunchConfiguration', Configuration), \
+                patch.object(module, 'Node', lambda **kwargs: kwargs):
+            return module._create_fastlivo_node(None)
+
+    def test_default_full_mount_and_tf_ownership(self):
+        """The default Nav2 setup must not duplicate base/camera TF ownership."""
+        nodes = self.nodes()
+        self.assertEqual([n['name'] for n in nodes], ['laserMapping', 'lidar_to_imu_tf'])
+        params = nodes[0]['parameters'][0]
+        self.assertEqual(params['frames/base_to_lidar_translation'], [0, 0, 0.9])
+        self.assertAlmostEqual(params['frames/base_to_lidar_quaternion'][1], math.sin(math.pi/12))
+        self.assertEqual(params['extrin_calib/extrinsic_T'], [0.04165, 0.02326, -0.0284])
+        self.assertEqual(params['frames/base'], 'base_link')
+        self.assertEqual(params['frames/odom'], 'odom')
+
+    def test_rotated_imu_transform_is_actual_inverse(self):
+        """Estimator and static transforms must compose to identity."""
+        for angle in [-150, -30, 0, 20, 110]:
+            nodes = self.nodes(lidar_to_imu_x='0.2', lidar_to_imu_y='-0.1',
+                               lidar_to_imu_z='0.4', lidar_to_imu_roll_deg=str(angle),
+                               lidar_to_imu_pitch_deg='17', lidar_to_imu_yaw_deg='40')
+            params = nodes[0]['parameters'][0]
+            values = dict(zip(nodes[1]['arguments'][::2], nodes[1]['arguments'][1::2]))
+            r = rotation([float(values[k]) for k in ['--qx', '--qy', '--qz', '--qw']])
+            t = [float(values[k]) for k in ['--x', '--y', '--z']]
+            inv = params['extrin_calib/extrinsic_R']
+            inv_t = params['extrin_calib/extrinsic_T']
+            for row in range(3):
+                for col in range(3):
+                    self.assertAlmostEqual(sum(r[row][k]*inv[3*k+col] for k in range(3)),
+                                           1 if row == col else 0)
+                self.assertAlmostEqual(t[row] + sum(r[row][k]*inv_t[k] for k in range(3)), 0)
+
+    def test_nav2_input_and_image_disable(self):
+        """The local relay input and LIO-only switch reach the mapper."""
+        p = self.nodes(lidar_topic='/livox/lidar_local', image_enable='false')[0]['parameters'][0]
+        self.assertEqual(p['common/lid_topic'], '/livox/lidar_local')
+        self.assertEqual(p['common/img_en'], 0)
+        self.assertEqual(p['buffers/lidar_qos_depth'], 4)
+        self.assertEqual(p['buffers/image_qos_depth'], 2)
+
+    def test_optional_static_publishers(self):
+        """Standalone static publisher switches retain their behavior."""
+        self.assertEqual(len(self.nodes(publish_lidar_to_imu_tf='false')), 1)
+        self.assertEqual(len(self.nodes(publish_sensor_static_tf='true')), 4)
+
+    def test_actual_mapper_publish_wiring(self):
