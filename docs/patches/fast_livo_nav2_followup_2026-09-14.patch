diff --git a/include/buffer_contract.h b/include/buffer_contract.h
new file mode 100644
index 0000000..b384a81
--- /dev/null
+++ b/include/buffer_contract.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <cstddef>
+#include <stdexcept>
+#include <string>
+
+namespace fast_livo
+{
+// Never silently discard IMU integration history on application-buffer overflow.
+// Terminating this estimator lets the independent Nav2 TF/command watchdog stop.
+inline void require_buffer_space(std::size_t size, std::size_t limit, const char * name)
+{
+  if (limit == 0 || size >= limit) {
+    throw std::runtime_error(std::string(name) +
+      " application buffer limit reached; stop and restart localization/perception after diagnosis");
+  }
+}
+
+template<typename Measurements, typename Measurement>
+void replace_measurement(Measurements & pending, const Measurement & current)
+{
+  pending.clear();
+  pending.push_back(current);
+}
+
+// The input window has been consumed even when projection produces ZERO RGB points.
+template<typename Cloud, typename Consumer>
+bool consume_publication_window(
+  Cloud & pending, const Cloud & batch, std::size_t & count,
+  std::size_t window, Consumer consume)
+{
+  if (window == 0) {throw std::invalid_argument("publish window must be positive");}
+  pending += batch;
+  if (++count < window) {return false;}
+  consume(pending);
+  Cloud().swap(pending);
+  count = 0;
+  return true;
+}
+}  // namespace fast_livo
diff --git a/include/measurement_stamp.h b/include/measurement_stamp.h
new file mode 100644
index 0000000..7b9ef80
--- /dev/null
+++ b/include/measurement_stamp.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cmath>
+#include <stdexcept>
+
+namespace fast_livo
+{
+enum class StampStatus {accepted, invalid, out_of_order, clock_reset};
+
+// Small disorder is rejected without clearing paired data/time queues. A large
+// rollback cannot safely reuse the current estimator state and requires restart.
+inline StampStatus inspect_measurement_stamp(double stamp, double previous)
+{
+  if (!std::isfinite(stamp) || stamp <= 0) {return StampStatus::invalid;}
+  if (previous > 0 && stamp < previous - 0.5) {return StampStatus::clock_reset;}
+  if (stamp <= previous) {return StampStatus::out_of_order;}
+  return StampStatus::accepted;
+}
+
+inline void require_new_odometry_stamp(double stamp, double previous)
+{
+  if (!std::isfinite(stamp) || stamp <= 0 || stamp <= previous) {
+    throw std::runtime_error("odometry measurement stamp invalid/non-increasing; restart required");
+  }
+}
+}  // namespace fast_livo
